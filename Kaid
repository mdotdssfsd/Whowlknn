                        hrp.Velocity = Vector3.new(humanoid.MoveDirection.X * 70, hrp.Velocity.Y, humanoid.MoveDirection.Z * 70)
                    end
                end
            end)
        end
        RunService.Heartbeat:Wait()
    end
end)


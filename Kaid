-- --- GET HIGHEST VALID COMPETITIVE TARGET TARGET ---
local function GetClosestTarget(root)
    local closest, maxDist = nil, Settings.Range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = p.Character.HumanoidRootPart
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < maxDist then
                    closest = targetRoot
                    maxDist = dist
                end
            end
        end
    end
    return closest
end

-- Track Combat Inputs for M1 Auto Connection
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not Settings.AutoConnect then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local target = GetClosestTarget(root)
            if target then
                root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))
            end
        end
    end
end)

-- --- THE RUNTIME COMBAT ENGINE (Heartbeat Utility Only) ---
RunService.Heartbeat:Connect(function()
    local Char = LocalPlayer.Character
    if not Char then return end

    -- Handle Auto Keep Fist Out Engine
    if Settings.AutoKeepFist then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            local fist = bp:FindFirstChild("Combat") or bp:FindFirstChild("Fist") or bp:FindFirstChild("Fists")
            if fist and Char:FindFirstChildOfClass("Humanoid") then
                Char:FindFirstChildOfClass("Humanoid"):EquipTool(fist)
            end
        end
    end
end)

-- --- DEDICATED HITBOX ENFORCEMENT LOOP (0.1s Interval) ---
task.spawn(function()
    while true do
        task.wait(0.1) 
        
        local Char = LocalPlayer.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")
        
        if Root then
            local activeColorData = ColorList[Settings.CurrentColorIndex]
            local targetAlpha = TransparencyList[Settings.CurrentTransIndex]

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local ERoot = p.Character:FindFirstChild("HumanoidRootPart")
                    local EHum = p.Character:FindFirstChildOfClass("Humanoid")

                    if ERoot and EHum and EHum.Health > 0 then
                        local Dist = (Root.Position - ERoot.Position).Magnitude
                        if Settings.ShowHitboxes and Dist <= Settings.Range then
                            local TargetScale = Settings.HitboxSize * 1.8
                            ERoot.Size = Vector3.new(TargetScale, TargetScale, TargetScale)
                            ERoot.CanCollide = false
                            
                            if activeColorData.IsClear then
                                ERoot.Transparency = 1
                            else
                                ERoot.Transparency = targetAlpha
                                ERoot.Color = activeColorData.Color
                                ERoot.Material = Enum.Material.Neon
                            end
                        else
                            ERoot.Size = Vector3.new(2, 2, 1)
                            ERoot.Transparency = 1
                            ERoot.Material = Enum.Material.Plastic
                        end
                    end
                end
            end
        end
    end
end)

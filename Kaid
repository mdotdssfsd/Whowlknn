local function SendGlobalChatMessage(msgText)
    pcall(function()
        local textChatService = game:GetService("TextChatService")
        if textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = textChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                channel:SendAsync(msgText)
            end
        else
            game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents"):WaitForChild("SayMessageRequest"):FireServer(msgText, "All")
        end
    end)
end

